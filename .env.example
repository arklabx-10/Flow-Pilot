# =============================================================================
# FlowPilot Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to `.env` for local development.
# SECURITY RULE: Never commit `.env` or real credentials, API keys, or secrets.
# All values below are safe local development placeholders.
# =============================================================================

# --- Shared PostgreSQL Database (Docker Compose & API) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flowpilot_dev
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=flowpilot_local_dev_only

# --- ASP.NET Core Web API (services/api) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__SharedPostgres=Host=localhost;Port=5432;Database=flowpilot_dev;Username=flowpilot;Password=flowpilot_local_dev_only
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:1420
Cors__AllowedOrigins__2=tauri://localhost
# Cloud Speech Provider Credentials (Server-side ONLY — NEVER expose in VITE_* client variables)
SpeechProvider__MaxAudioBytes=26214400
SpeechProvider__OpenAi__ApiKey=
SpeechProvider__OpenAi__BaseUrl=https://api.openai.com/v1
SpeechProvider__OpenAi__Model=whisper-1
SpeechProvider__OpenAi__TimeoutSeconds=30

# --- Web Companion App (apps/web) ---
VITE_API_BASE_URL=http://localhost:5080
VITE_APP_ENV=development

# --- Windows Desktop App (apps/desktop) ---
VITE_DESKTOP_API_BASE_URL=http://localhost:5080
FLOWPILOT_SQLITE_FILENAME=flowpilot_local.db
