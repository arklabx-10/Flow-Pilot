{
  "name": "@flowpilot/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "FlowPilot versioned OpenAPI specifications and shared TypeScript contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v1/openapi.yaml": "./openapi/v1/openapi.yaml"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "yaml": "^2.7.0"
  }
}
