{
  "name": "@flowpilot/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "FlowPilot Windows Desktop Application (Tauri 2 + React + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 1421",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@flowpilot/contracts": "*",
    "@tauri-apps/api": "^2.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
